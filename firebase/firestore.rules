rules_version = '2';

// Lentera stores one document per summary. There is no user-visible account
// system, so ownership is anonymous: the client generates a random UUID and
// keeps it in chrome.storage.local. Every write must carry that id, and every
// read is restricted to the same id.
//
// The tradeoff is explicit: anyone holding an id can read that id's summaries.
// The id is 128 bits of randomness, never logged, never shown in the UI, and
// never derived from the user's text. What is protected is the *text of the
// documents*, which is the thing worth protecting.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownsId() {
      return request.auth == null
        ? false
        : request.auth.uid == request.resource.data.ownerId;
    }

    match /summaries/{summaryId} {
      allow read, delete: if ownsId();
      allow create: if ownsId()
        && request.resource.data.keys().hasOnly([
             'ownerId', 'text', 'source', 'tokens', 'charCount', 'createdAt'
           ])
        && request.resource.data.ownerId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 6000
        && request.resource.data.source in ['on_device', 'in_cloud', 'UNKNOWN']
        && request.resource.data.tokens is int
        && request.resource.data.tokens >= 0
        && request.resource.data.tokens <= 100000
        && request.resource.data.charCount is int
        && request.resource.data.charCount >= 0
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Everything else is closed. If a future collection is added, it must be
    // declared here rather than inheriting a permissive default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
