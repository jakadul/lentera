# Firebase client config.
#
# Copy the values from Firebase console > Project settings > Your apps > Web app.
# This file is gitignored. These are public client identifiers, not secrets;
# the thing that must never be committed is an App Check debug token.
#
# Leave VITE_FB_APPCHECK_DEBUG unset in production builds.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
# App Check (required — the Firebase console workflow enforces it on AI Logic).
# reCAPTCHA Enterprise site key from console > App Check > Apps > reCAPTCHA.
VITE_FB_APPCHECK_SITE_KEY=

# Set to true only for a local build. Prints an App Check debug token to the
# console that must be safelisted in Firebase console > App Check > Apps.
# Never ship a build with this on.
VITE_FB_APPCHECK_DEBUG=
